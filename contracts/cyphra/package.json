{
  "name": "@cyphra/contracts",
  "version": "0.1.0",
  "description": "CYPHRA Compact smart contracts for Midnight Network — confidential payments",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "compact:compile": "compact compile src/cyphra.compact src/managed",
    "compact:compile:wsl": "wsl compact compile src/cyphra.compact src/managed",
    "build": "tsc",
    "dev": "echo 'contracts ready'",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/cyphra.test.js",
    "test:watch": "node --test --watch src/",
    "lint": "echo 'contracts lint ok'",
    "deploy:preview": "node dist/deployment/deploy.js",
    "deploy:preprod": "node dist/deployment/deploy.js",
    "deploy:mainnet": "node dist/deployment/deploy.js",
    "deploy:local": "node dist/deployment/deploy.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@cyphra/shared": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/midnight-js": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.0"
  }
}
