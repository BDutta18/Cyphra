# CYPHRA Preprod — copy to .env.preprod locally; never commit real secrets.
# Midnight.js is configured programmatically with setNetworkId('preprod'); these
# variables are the application configuration consumed by CYPHRA.
CYPHRA_DEPLOYMENT_ENV=preprod
NODE_ENV=production
PORT=4000

MIDNIGHT_NETWORK=preprod
MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network
MIDNIGHT_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# A proof server handles private witness data and must remain local to the
# operator; do not point this at a public deployment.
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Set only after a real `deployContract` transaction is finalized on Preprod.
# Midnight.js returns this as a 64-hex contract address (not a wallet address).
CONTRACT_ADDRESS=your_64_hex_real_deployed_contract_address

NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preprod
NEXT_PUBLIC_API_URL=https://your-preprod-backend.example.com
NEXT_PUBLIC_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_CYPHRA_CONTRACT_ADDRESS=your_64_hex_real_deployed_contract_address
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://preprod.midnightexplorer.com

# Backend only. Keep this in the protected GitHub `preprod` Environment and
# the Preprod backend host; never expose it as NEXT_PUBLIC_*.
API_KEY=generate_a_unique_preprod_api_key
CORS_ORIGINS=https://your-preprod-frontend.example.com

# GitHub `preprod` Environment:
# secret: VERCEL_PREPROD_TOKEN, RENDER_PREPROD_DEPLOY_HOOK_URL
# variables: VERCEL_ORG_ID, VERCEL_PREPROD_PROJECT_ID, CYPHRA_PREPROD_API_URL,
#   CYPHRA_PREPROD_CONTRACT_ADDRESS, CYPHRA_PREPROD_HEALTHCHECK_URL
