# ==========================================
# Cyphra - Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# Runtime
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# ──────────────────────────────────────────
# Midnight Network — Preview (default)
# Endpoints via Blockfrost (https://blockfrost.io)
# Requires a Blockfrost project_id for Preview network
# ──────────────────────────────────────────
MIDNIGHT_NETWORK_ID=preview
BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

MIDNIGHT_INDEXER_URI=https://midnight-preview.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS_URI=wss://midnight-preview.blockfrost.io/api/v0/ws
MIDNIGHT_NODE_URI=https://rpc.midnight-preview.blockfrost.io

# ──────────────────────────────────────────
# CYPHRA Smart Contract (Midnight Preview)
# Deployed contract address on Preview network
# ──────────────────────────────────────────
CYPHRA_CONTRACT_ADDRESS=your_deployed_midnight_preview_contract_address

# ──────────────────────────────────────────
# Security (inter-service only — wallet auth stays in 1AM Wallet)
# ──────────────────────────────────────────
API_KEY=cyphra_dev_api_key_change_in_production

# ──────────────────────────────────────────
# CORS — comma-separated allowed origins
# Add your Vercel preview URLs here
# ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cyphra-two.vercel.app

# ──────────────────────────────────────────
# Next.js Public Vars (accessible by browser)
# Set these in Vercel Dashboard → Environment Variables → Preview
# ──────────────────────────────────────────
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preview
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INDEXER_URI=https://midnight-preview.blockfrost.io/api/v0
NEXT_PUBLIC_CYPHRA_CONTRACT_ADDRESS=your_deployed_midnight_preview_contract_address
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://midnightexplorer.com
