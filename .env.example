# ==========================================
# Cyphra - Environment Configuration
# ==========================================

# Network Configuration
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# Midnight Network Endpoints (Testnet / Devnet)
MIDNIGHT_NETWORK_ID=testnet
MIDNIGHT_INDEXER_URI=https://indexer.testnet.midnight.network/api/v1/graphql
MIDNIGHT_INDEXER_WS_URI=wss://indexer.testnet.midnight.network/api/v1/graphql/ws
MIDNIGHT_NODE_URI=https://rpc.testnet.midnight.network
MIDNIGHT_PROVER_SERVER_URI=https://prover.testnet.midnight.network

# Smart Contract
CYPHRA_CONTRACT_ADDRESS=mn_contract1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqcyphra

# Security & Secrets
JWT_SECRET=cyphra_dev_jwt_secret_change_in_production_32_bytes_min
API_KEY=cyphra_dev_api_key_testnet

# Next.js Public Vars (accessible by client)
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=testnet
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INDEXER_URI=https://indexer.testnet.midnight.network/api/v1/graphql
NEXT_PUBLIC_DEFAULT_EXPLORER_URL=https://explorer.testnet.midnight.network
