# CYPHRA Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Midnight Network Configuration
# Supported networks: preview, preprod, mainnet
MIDNIGHT_NETWORK=preprod
MIDNIGHT_NODE_RPC=https://rpc.testnet-02.midnight.network
MIDNIGHT_INDEXER_URI=https://indexer.testnet-02.midnight.network/api/v1/graphql
MIDNIGHT_PROVER_SERVER=https://prover.testnet-02.midnight.network

# CYPHRA Deployed Compact Contract Address on Midnight Preprod
CYPHRA_CONTRACT_ADDRESS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX_REQUESTS=30

# Logging level: error, warn, info, debug
LOG_LEVEL=info
