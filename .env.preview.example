# ==========================================
# Cyphra — Preview Environment Configuration
# ==========================================
# Copy to .env.local to run against Midnight Preview network.
# Set these in Vercel Dashboard -> Project -> Settings -> Environment Variables
# scoped to "Preview" deployments ONLY. Never commit real secrets.
# ==========================================

# Runtime
NODE_ENV=production
PORT=4000

# Midnight Network: PREVIEW (Blockfrost)
# Sign up at https://blockfrost.io and create a Midnight Preview project
MIDNIGHT_NETWORK_ID=preview
BLOCKFROST_PROJECT_ID=your_blockfrost_midnight_preview_project_id

MIDNIGHT_INDEXER_URI=https://midnight-preview.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS_URI=wss://midnight-preview.blockfrost.io/api/v0/ws
MIDNIGHT_NODE_URI=https://rpc.midnight-preview.blockfrost.io

# CYPHRA Smart Contract (Midnight Preview)
# Explorer: https://midnightexplorer.com (switch network to Preview)
CYPHRA_CONTRACT_ADDRESS=your_deployed_midnight_preview_contract_address

# Security
API_KEY=generate_strong_random_secret_here

# CORS - allow Vercel preview deployments to reach backend
CORS_ORIGINS=https://cyphra-two.vercel.app,https://*.vercel.app

# Next.js Public Vars (embedded at build time, scoped to Preview in Vercel)
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preview
NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com
NEXT_PUBLIC_INDEXER_URI=https://midnight-preview.blockfrost.io/api/v0
NEXT_PUBLIC_CYPHRA_CONTRACT_ADDRESS=your_deployed_midnight_preview_contract_address
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://midnightexplorer.com

# GitHub Actions configuration (create a protected `preview` Environment):
#   secret: VERCEL_PREVIEW_TOKEN
#   variables: VERCEL_ORG_ID, VERCEL_PROJECT_ID,
#     CYPHRA_PREVIEW_API_URL, CYPHRA_PREVIEW_INDEXER_URI,
#     CYPHRA_PREVIEW_CONTRACT_ADDRESS, CYPHRA_PREVIEW_EXPLORER_URL
# Keep Blockfrost credentials on the Preview backend only. Do not place them
# in Vercel/Next.js public variables or the GitHub preview workflow.
